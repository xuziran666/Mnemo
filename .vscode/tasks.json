{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "运行 Mnemo",
			"type": "shell",
			"command": "cargo",
			"args": [
				"run",
				"-p",
				"mnemo-slint"
			],
			"problemMatcher": [
				"$rustc"
			],
			"detail": "编译并运行 Mnemo（Slint 版，二进制名 mnemo）"
		},
		{
			"label": "构建发布",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--release",
				"-p",
				"mnemo-slint"
			],
			"problemMatcher": [
				"$rustc"
			],
			"detail": "生成 release 可执行文件 target/release/mnemo(.exe)"
		},
		{
			"label": "编译检查（快）",
			"type": "shell",
			"command": "cargo",
			"args": [
				"check",
				"-p",
				"mnemo-slint"
			],
			"problemMatcher": [
				"$rustc"
			],
			"detail": "只做类型检查，不产出二进制"
		}
	]
}
