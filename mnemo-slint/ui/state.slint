// 数据契约与文案。
// State.commands 由 Rust 侧（src/data.rs）从 mnemo-core 查询后写入，UI 内没有 mock 数据；
// Strings 内的文案由 locales/*.json 注入（见后续步骤）。
// 颜色/尺寸请统一走 Theme，不要在这里写死。

// 列表条目。kind 与 mnemo-core::models::{KIND_SNIPPET, KIND_NOTE} 对齐。
export struct CommandItem {
    id: int,
    title: string,
    content: string,
    note: string,
    tags: [string],
    kind: int, // 1 = Snippet（Code），2 = Note
}

// 语言下拉选项。
export struct LangOption {
    code: string,
    label: string,
}

// 界面文案（P0 默认英文，与 locales/en.json 保持一致）。
export global Strings {
    in-out property <string> search-placeholder: "Search commands...";
    in-out property <string> lang-title: "Switch language";
    in-out property <string> io-import: "Import";
    in-out property <string> io-export: "Export";
    in-out property <string> add-title: "Add command";

    in-out property <string> badge-code: "Code";
    in-out property <string> badge-note: "Note";
    in-out property <string> action-view: "View";
    in-out property <string> action-copy: "Copy";
    in-out property <string> action-edit: "Edit";
    in-out property <string> action-delete: "Delete";

    in-out property <string> empty: "No commands found";
}

// 界面状态（Rust 侧可通过 ui.global::<State>() 读写）。
export global State {
    // 列表数据：由 Rust 侧（src/data.rs）从 mnemo-core 查询后写入
    in-out property <[CommandItem]> commands: [];

    // 搜索关键词：SearchBox 双向绑定，Rust 侧据此调用 mnemo_core::list 过滤（LIKE 转义在 core 内部）
    in-out property <string> query: "";

    // 选中条目的 id（用 id 而不是下标：列表过滤/刷新后仍然稳定）
    // 0 表示无选中（数据库自增 id 从 1 开始，不会与真实条目冲突）
    in-out property <int> selected-id: 0;

    // 语言：code 用于下拉选中态判断，label 用于按钮显示
    in-out property <[LangOption]> langs: [
        { code: "en", label: "English" },
        { code: "zh", label: "中文" },
    ];
    in-out property <string> lang-code: "en";
    in-out property <string> lang-label: "English";
}
