import { Theme } from "theme.slint";
import { State, Strings } from "state.slint";
// ScrollView / ListView 等视图组件定义在 std-widgets 中，必须显式导入
import { ScrollView } from "std-widgets.slint";
import { TitleBar } from "components/TitleBar.slint";
import { Toolbar } from "components/Toolbar.slint";
import { CommandCard } from "components/CommandCard.slint";
import { EditorPanel } from "components/EditorPanel.slint";
import { ViewerPanel } from "components/ViewerPanel.slint";
import { ConfirmDialog } from "components/ConfirmDialog.slint";
import { Toast } from "components/Toast.slint";

// 从其它 .slint 文件重导出。
// slint::include_modules!() 只会把"被编译文件自身导出"的符号暴露给 Rust，
// 因此全局单例（Theme/State/Strings）、结构体与枚举必须在这里重导出，
// 否则 Rust 侧会报 "cannot find type ..."。
export { Theme } from "theme.slint";
export { State, Strings, CommandItem } from "state.slint";
export { IconKind } from "components/IconButton.slint";

// 主窗口：无边框 + 始终置顶；关闭即退出，不再失焦隐藏或缩到托盘。
export component MainWindow inherits Window {
    // 供 Rust 侧绑定业务逻辑
    // 注意：card-activated = 点击卡片正文，当前只用于「选中」（Rust 侧不注册处理函数），
    // 刻意不沿用旧版"点正文即复制/查看"的行为，避免误关窗。
    callback card-activated(int);
    callback copy-requested(int);
    // Enter：Snippet 复制并退出；Note 打开只读查看层（语义与 README 一致）
    callback activate-requested(int);
    callback edit-requested(int);
    callback delete-requested(int);
    callback import-clicked();
    callback export-clicked();
    callback new-clicked();
    // 主题 / 语言：点击即切换（无下拉），实现在 Rust 侧（含 settings.json 持久化）
    callback theme-clicked();
    callback lang-clicked();

    // 搜索关键词变化（每次输入触发）→ Rust 侧查询 mnemo-core 并刷新列表
    callback query-changed(string);

    // 键盘导航与弹层（实现见 src/main.rs）
    callback select-move(int); // ↑/↓ 移动选中项：+1 / -1
    callback editor-save();       // 保存（Rust 侧校验 title/content 必填后写库）
    callback confirm-ok();        // 确认删除（取消/关闭直接在 .slint 侧改 State，不必回 Rust）
    callback view-requested(int); // 查看：Rust 用列表缓存填充 State.viewing 后打开查看弹层
    callback viewer-edit();       // 查看弹层里的「编辑」：关查看 → 开编辑器

    // 无边框窗口的系统级操作（Rust 侧实现，全部由自定义顶栏触发）：
    // 拖动 / 最小化到任务栏 / 最大化还原 / 关闭（关闭 = 退出应用）
    callback drag-requested();
    callback minimize-requested();
    callback maximize-requested();
    callback quit-requested();

    title: "Mnemo";
    // Window 上 width/height 与 min-width/min-height 互斥：
    // 初始尺寸用 preferred-*，最小尺寸用 min-*（这样窗口仍可自由缩放）。
    preferred-width: 900px;
    preferred-height: 650px;
    min-width: 500px;
    // 最小高度要容纳新建/编辑浮层（约 424px + 上下留白），否则缩到最小尺寸时"保存"按钮会跑到窗口外
    min-height: 500px;
    background: Theme.bg;
    icon: @image-url("../assets/icons/icon.png");

    no-frame: true;
    always-on-top: true;
    resize-border-width: 6px;

    // 初始焦点交给键盘捕获作用域：启动后不点任何控件也能直接用快捷键
    forward-focus: content-scope;

    // 窗口拖动已移入自定义顶栏（TitleBar.slint）：只有顶栏区域可拖动，且最大化时拖动自动失效。
    // 这里不再放 WindowMoveArea（为什么改用 TouchArea，见 TitleBar.slint 顶部注释）。

    // ---------- 键盘捕获 ----------
    // FocusScope 必须包住整个内容树：它只在"自身有焦点"或"包裹着有焦点的子元素"时才会收到按键，
    // 因此不能用一个独立的小元素来当键盘作用域。初始焦点由上面的 forward-focus 指定。
    // 键名依据 i-slint-common-1.18.1/key_codes.rs：DownArrow / UpArrow / Return（不是 Enter）、字母必须大写。
    content-scope := FocusScope {
        width: 100%;
        height: 100%;

        // ↑/↓：移动选中项。下标计算放在 Rust 侧：Slint 的 for 循环拿不到下标，
        // 选中态只能用 id 表示，再由持有列表缓存的一侧换算下标（见 main.rs 的 move_selection）。
        KeyBinding {
            keys: @keys(DownArrow);
            enabled: !toolbar.search-focused && !State.modal-open;
            activated => { root.select-move(1); }
        }
        KeyBinding {
            keys: @keys(UpArrow);
            enabled: !toolbar.search-focused && !State.modal-open;
            activated => { root.select-move(-1); }
        }
        // Enter：交给 Rust 按 kind 分流（Snippet 复制关窗 / Note 打开查看层），
        // 不直接在 .slint 里判断类型，避免与列表缓存保持两套数据。
        KeyBinding {
            keys: @keys(Return);
            enabled: !toolbar.search-focused && !State.modal-open && (State.selected-id != 0);
            activated => { root.activate-requested(State.selected-id); }
        }
        // Ctrl+N：新建（Windows/Linux 用 Control；macOS 的 Command 对应 Meta，两条都绑上）
        KeyBinding {
            keys: @keys(Control + N);
            enabled: !State.modal-open;
            activated => { root.new-clicked(); }
        }
        KeyBinding {
            keys: @keys(Meta + N);
            enabled: !State.modal-open;
            activated => { root.new-clicked(); }
        }
        // s：聚焦搜索框。搜索框已聚焦时字母键会被 TextInput 消费，这里再加 enabled 双保险。
        KeyBinding {
            keys: @keys(S);
            enabled: !toolbar.search-focused && !State.modal-open;
            activated => { toolbar.focus-search(); }
        }

        // R / C / V / D：编辑 / 复制 / 查看 / 删除选中项（对齐旧版 egui 的单键动作）。
        // 与 Enter 同一套守卫：搜索框聚焦时让位给输入，无选中时不触发。
        KeyBinding {
            keys: @keys(R);
            enabled: !toolbar.search-focused && !State.modal-open && (State.selected-id != 0);
            activated => { root.edit-requested(State.selected-id); }
        }
        KeyBinding {
            keys: @keys(C);
            enabled: !toolbar.search-focused && !State.modal-open && (State.selected-id != 0);
            activated => { root.copy-requested(State.selected-id); }
        }
        KeyBinding {
            keys: @keys(V);
            enabled: !toolbar.search-focused && !State.modal-open && (State.selected-id != 0);
            activated => { root.view-requested(State.selected-id); }
        }
        KeyBinding {
            keys: @keys(D);
            enabled: !toolbar.search-focused && !State.modal-open && (State.selected-id != 0);
            activated => { root.delete-requested(State.selected-id); }
        }

        // 自定义顶栏：通栏贴顶（不受内容区 Theme.pad-window 影响）。
        // 高度由组件内部的 height: Theme.titlebar-h 决定——非布局子元素不读取 min/max-*，
        // 只写 min/max 会退化成整窗高度，把顶栏内容挤到窗口中间。
        titlebar := TitleBar {
            x: 0;
            y: 0;
            width: parent.width;

            drag-requested => { root.drag-requested(); }
            minimize-clicked => { root.minimize-requested(); }
            maximize-clicked => { root.maximize-requested(); }
            close-clicked => { root.quit-requested(); }
        }

        // 内容区：让开顶栏高度，保留原有内边距
        VerticalLayout {
            x: 0;
            y: Theme.titlebar-h;
            width: 100%;
            height: parent.height - Theme.titlebar-h;
            padding: Theme.pad-window;
            spacing: Theme.gap-card;

            toolbar := Toolbar {
                query <=> State.query;

                query-edited(q) => {
                    // 写入 State（保持输入框内容）+ 转给 Rust 侧查询；本地 SQLite + LIKE 足够快，暂不做防抖
                    State.query = q;
                    root.query-changed(q);
                }
                // 主题 / 语言：Rust 侧切换全局状态并持久化 settings.json（切换后界面自动重绘）
                theme-clicked => { root.theme-clicked(); }
                lang-clicked => { root.lang-clicked(); }
                import-clicked => { root.import-clicked(); }
                export-clicked => { root.export-clicked(); }
                new-clicked => { root.new-clicked(); }

                // 搜索框内按 Enter：把操作权交给列表。
                // content-scope.focus() 会独占焦点（Slint 焦点唯一），搜索框随之失焦；
                // 之后 ↑/↓/Enter/R/C/V/D 都作用于列表。复用 select-move：无选中时它正好取第一条。
                search-accepted => {
                    content-scope.focus();
                    if (State.selected-id == 0) {
                        root.select-move(1);
                    }
                }
            }

            // ---------- 命令卡片列表 ----------
            if (State.commands.length > 0) : card-scroll := ScrollView {
                vertical-stretch: 1;

                // 用 VerticalLayout + spacing 控制卡片间距。
                // 宽度必须显式跟随可视宽度：否则 ScrollView 的 content-width 会退化成内容最小宽度，卡片会变窄。
                VerticalLayout {
                    width: card-scroll.visible-width;
                    spacing: Theme.gap-card;
                    // 滚动内容的内边距（窗口本身已有 Theme.pad-window 外边距，这里只留与滚动条的呼吸空间）
                    padding: Theme.gap-card;

                    // 直接在 for 循环中渲染 CommandCard（布局会负责拉伸宽度，不要再写 width）
                    for item in State.commands : CommandCard {
                        item: item;
                        selected: State.selected-id == item.id;

                        card-clicked => {
                            State.selected-id = item.id;
                            root.card-activated(item.id);
                        }
                        view-clicked => { root.view-requested(item.id); }
                        copy-clicked => { root.copy-requested(item.id); }
                        edit-clicked => { root.edit-requested(item.id); }
                        delete-clicked => { root.delete-requested(item.id); }

                        // 卡片被选中时上报自身位置，这里调整滚动偏移让它进入可视区。
                        // 必须用 content-y：viewport-y 在 1.18 已标记 @deprecated（用它会出弃用警告）。
                        // 两种情况都要夹取到 [0, 内容高度-可视高度]：内容不足一屏时后者可能为负。
                        scroll-requested(y, h) => {
                            if (y < card-scroll.content-y) {
                                card-scroll.content-y = max(0px, y - Theme.gap-card);
                            } else if (y + h > card-scroll.content-y + card-scroll.height) {
                                card-scroll.content-y = max(
                                    0px,
                                    min(
                                        card-scroll.content-height - card-scroll.height,
                                        y + h - card-scroll.height + Theme.gap-card,
                                    ),
                                );
                            }
                        }
                    }
                }
            }

            // ---------- 空态 ----------
            if (State.commands.length == 0) : Text {
                vertical-stretch: 1;
                text: Strings.empty;
                color: Theme.text-muted;
                font-size: Theme.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ---------- 弹层（声明在内容之后 → 位于最上层）----------
    // 声明顺序 = z 序：查看 < 编辑 < 确认 < 提示。
    // 实际操作中三者互斥（查看里点"编辑"会先关掉查看），顺序只决定极端情况下谁在上面。

    // 查看层
    if (State.viewing-open) : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Theme.overlay-bg;

        TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
        }

        // 查看层自己持有焦点，否则焦点仍留在 content-scope：
        // 按 Enter 会触发列表的复制并关窗，按 r/d 会在查看层上再叠一层弹层。
        viewer-scope := FocusScope {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            init => { viewer-scope.focus(); }

            // 与 README 一致：查看层内 Enter 原位进入编辑。
            KeyBinding {
                keys: @keys(Return);
                activated => { root.viewer-edit(); }
            }
            // 保留列表里的 c / r 语义（c 复制并关窗，r 编辑）。
            KeyBinding {
                keys: @keys(C);
                activated => { root.copy-requested(State.viewing.id); }
            }
            KeyBinding {
                keys: @keys(R);
                activated => { root.viewer-edit(); }
            }

            ViewerPanel {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                edit-requested => { root.viewer-edit(); }
                // 关闭弹层后把焦点还给列表。
                cancel => { State.viewing-open = false; root.focus-list(); }
            }
        }
    }

    // 层级与命中：遮罩是带 TouchArea 的全窗口 Rectangle，它吃掉点击，
    // 既不会穿透到下面的卡片，也不会落到更下层的 WindowMoveArea（弹层打开时不会误拖窗口）。
    // 点击遮罩不关闭弹层：避免误点丢失正在编辑的内容，"取消 / 保存"才是关闭入口。
    if (State.editor-open) : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Theme.overlay-bg;

        TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
        }

        // 编辑器自己的焦点作用域：只声明 Ctrl+S。
        // 为什么必须单独一个 scope：弹层刻意放在 content-scope 之外（避免编辑时触发列表快捷键），
        // 若把 Ctrl+S 塞进 content-scope，在列表里按 Ctrl+S 会去保存编辑器里的残留内容。
        // EditorPanel 的 init 会聚焦标题框（在本 scope 内），按键据此冒泡到这里。
        editor-scope := FocusScope {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            KeyBinding {
                keys: @keys(Control + S);
                activated => { root.editor-save(); }
            }
            // macOS 的 Command 对应 Meta；README 同时承诺了 Cmd+S。
            KeyBinding {
                keys: @keys(Meta + S);
                activated => { root.editor-save(); }
            }

            EditorPanel {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                save => { root.editor-save(); }
                // 关闭编辑层后把焦点还给列表：editor-scope 销毁后焦点不会自动回到 content-scope。
                cancel => { State.editor-open = false; root.focus-list(); }
            }
        }
    }

    if (State.confirm-open) : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Theme.overlay-bg;

        TouchArea {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
        }

        // 确认框也自己持有焦点：Enter = 确认删除，避免落到列表的 Enter 上复制关窗。
        confirm-scope := FocusScope {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            init => { confirm-scope.focus(); }

            KeyBinding {
                keys: @keys(Return);
                activated => { root.confirm-ok(); }
            }

            ConfirmDialog {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                confirmed => { root.confirm-ok(); }
                cancelled => { State.confirm-open = false; root.focus-list(); }
            }
        }
    }

    // 提示层：铺满窗口但不拦截鼠标（Toast 内部没有 TouchArea），放在最上层以免被弹层遮住。
    if (State.toast-visible) : Toast {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        text: State.toast-text;
    }

    // 供 Rust 在保存/关闭弹层后把焦点还给列表。
    // 弹层销毁时 Slint 不会自动把焦点交还给 content-scope（forward-focus 只在初始化时执行一次）。
    public function focus-list() {
        content-scope.focus();
    }
}
