import { Theme } from "../theme.slint";

// 图标类型：导入（箭头向下收入托架）/ 导出（箭头向上送出）/ 新建 / 最小化 / 最大化 / 还原 / 关闭
export enum IconKind {
    icon-import,
    icon-export,
    icon-add,
    icon-minimize,
    icon-maximize,
    icon-restore,
    icon-close,
}

// 图标绘制区：统一按 16x16 的局部坐标编写（与 Theme.icon-size 对应）。
// 不使用 stroke，全部由填充矩形 + 填充三角形（Path）组成，避免不同渲染器的描边差异。
component IconGlyph inherits Rectangle {
    in property <IconKind> kind: IconKind.icon-add;
    in property <color> glyph-color: Theme.text;

    // 线宽与托架左右内缩
    private property <length> bar: 1.8px;
    private property <length> inset: 2px;

    width: Theme.icon-size;
    height: Theme.icon-size;
    background: transparent;

    // ---- 新建：十字 ----
    if (root.kind == IconKind.icon-add) : Rectangle {
        x: 0;
        y: (root.height - root.bar) / 2;
        width: root.width;
        height: root.bar;
        background: root.glyph-color;
    }
    if (root.kind == IconKind.icon-add) : Rectangle {
        x: (root.width - root.bar) / 2;
        y: 0;
        width: root.bar;
        height: root.height;
        background: root.glyph-color;
    }

    // ---- 最小化：单条横杠（无边框窗口没有系统标题栏，需要自己画）----
    if (root.kind == IconKind.icon-minimize) : Rectangle {
        x: (root.width - 10px) / 2;
        y: (root.height - root.bar) / 2;
        width: 10px;
        height: root.bar;
        background: root.glyph-color;
    }

    // ---- 关闭：两条 45° 交叉的平行四边形（仍是纯填充，不用 stroke）----
    // 每条斜杠与其它图标同粗细（1.8px 垂直宽度）；包围盒与元素尺寸一致 → Path 缩放系数为 1。
    if (root.kind == IconKind.icon-close) : Path {
        x: 2.2px;
        y: 2.2px;
        width: 11.6px;
        height: 11.6px;
        commands: "M 2.2 3.473 L 3.473 2.2 L 13.8 12.527 L 12.527 13.8 Z";
        fill: root.glyph-color;
    }
    if (root.kind == IconKind.icon-close) : Path {
        x: 2.2px;
        y: 2.2px;
        width: 11.6px;
        height: 11.6px;
        commands: "M 2.2 12.527 L 3.473 13.8 L 13.8 3.473 L 12.527 2.2 Z";
        fill: root.glyph-color;
    }

    // ---- 最大化：空心方框 ----
    // 一个方框 = 4 条填充边（沿用"图标只用填充、不用 stroke"的约定）。
    // 这里用紧凑的单行写法，因为 4 条边完全同构，逐行展开反而难读。
    if (root.kind == IconKind.icon-maximize) : Rectangle { x: 3.2px; y: 3.2px; width: 9.6px; height: 1.5px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-maximize) : Rectangle { x: 3.2px; y: 11.3px; width: 9.6px; height: 1.5px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-maximize) : Rectangle { x: 3.2px; y: 3.2px; width: 1.5px; height: 9.6px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-maximize) : Rectangle { x: 11.3px; y: 3.2px; width: 1.5px; height: 9.6px; background: root.glyph-color; }

    // ---- 还原（向下还原）：两个叠放的方框，后框只画露在外面的上边与右边 ----
    // 前框 [2.2,11.0]x[5.5,14.0]，后框 [5.0,13.8]x[2.2,10.7]
    if (root.kind == IconKind.icon-restore) : Rectangle { x: 2.2px; y: 5.5px; width: 8.8px; height: 1.5px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-restore) : Rectangle { x: 2.2px; y: 12.5px; width: 8.8px; height: 1.5px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-restore) : Rectangle { x: 2.2px; y: 5.5px; width: 1.5px; height: 8.5px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-restore) : Rectangle { x: 9.5px; y: 5.5px; width: 1.5px; height: 8.5px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-restore) : Rectangle { x: 5.0px; y: 2.2px; width: 8.8px; height: 1.5px; background: root.glyph-color; }
    if (root.kind == IconKind.icon-restore) : Rectangle { x: 12.3px; y: 2.2px; width: 1.5px; height: 8.5px; background: root.glyph-color; }

    // ---- 导入：向下的箭头 + 底部托架 ----
    if (root.kind == IconKind.icon-import) : Rectangle {
        x: (root.width - root.bar) / 2;
        y: 0;
        width: root.bar;
        height: 7px;
        background: root.glyph-color;
    }
    // Path 会把图形缩放进 width/height 边界，这里让包围盒与元素尺寸完全一致（缩放系数为 1）
    if (root.kind == IconKind.icon-import) : Path {
        x: 3.2px;
        y: 6.6px;
        width: 9.6px;
        height: 4.8px;
        commands: "M 8 11.4 L 3.2 6.6 L 12.8 6.6 Z";
        fill: root.glyph-color;
    }
    if (root.kind == IconKind.icon-import) : Rectangle {
        x: root.inset;
        y: root.height - root.bar;
        width: root.width - root.inset * 2;
        height: root.bar;
        background: root.glyph-color;
    }

    // ---- 导出：顶部托架 + 向上的箭头 ----
    if (root.kind == IconKind.icon-export) : Rectangle {
        x: root.inset;
        y: 0;
        width: root.width - root.inset * 2;
        height: root.bar;
        background: root.glyph-color;
    }
    // Path 会把图形缩放进 width/height 边界，这里让包围盒与元素尺寸完全一致（缩放系数为 1）
    if (root.kind == IconKind.icon-export) : Path {
        x: 3.2px;
        y: 4.6px;
        width: 9.6px;
        height: 4.8px;
        commands: "M 8 4.6 L 12.8 9.4 L 3.2 9.4 Z";
        fill: root.glyph-color;
    }
    if (root.kind == IconKind.icon-export) : Rectangle {
        x: (root.width - root.bar) / 2;
        y: 9px;
        width: root.bar;
        height: 7px;
        background: root.glyph-color;
    }
}

// 图标按钮：34x34 圆角方块，底色 control-bg，悬停 control-bg-hover（danger 时悬停变红）。
export component IconButton inherits Rectangle {
    in property <IconKind> kind: IconKind.icon-add;
    // 危险操作（关闭窗口等）：悬停底色改用 danger 红，与普通按钮区分
    in property <bool> danger: false;
    // 透明底：用于自定义顶栏的窗口控制按钮（常态无底色，悬停才高亮，贴近系统标题栏观感）
    in property <bool> flat: false;
    callback clicked();

    background: touch.has-hover
        ? (root.danger ? Theme.danger-hover-bg : Theme.control-bg-hover)
        : (root.flat ? transparent : Theme.control-bg);
    border-radius: Theme.radius-control;

    min-width: Theme.icon-button-w;
    max-width: Theme.icon-button-w;
    min-height: Theme.control-h;
    max-height: Theme.control-h;

    animate background { duration: 120ms; }

    IconGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.kind;
        // danger 悬停时底色是实心红，图标改用白色保证对比度（亮色主题尤其明显）
        glyph-color: (root.danger && touch.has-hover) ? Theme.on-solid-text : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
