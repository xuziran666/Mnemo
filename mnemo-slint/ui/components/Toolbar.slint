import { Theme } from "../theme.slint";
import { Strings } from "../state.slint";
import { SearchBox } from "SearchBox.slint";
import { IconButton, IconKind } from "IconButton.slint";
import { SolidButton } from "SolidButton.slint";

// 顶部工具栏（顺序固定）：搜索框（自适应宽度）→ 主题切换 → 语言切换 → 导入 → 导出 → 新建。
// 说明：
// - 语言下拉（LangMenu）已按新设计移除，改为"点击即切换"的按钮（LangMenu.slint 文件保留但不再被引用）；
// - 最小化 / 关闭按钮已上移到自定义顶栏（TitleBar.slint）。
export component Toolbar inherits Rectangle {
    in-out property <string> query;

    // 供主窗口的键盘快捷键使用：搜索框是否聚焦 + 主动聚焦搜索框
    out property <bool> search-focused: search-box.input-focused;

    callback query-edited(string);
    callback theme-clicked();
    callback lang-clicked();
    callback import-clicked();
    callback export-clicked();
    callback new-clicked();

    background: transparent;
    min-height: Theme.control-h;
    max-height: Theme.control-h;

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: Theme.gap-control;

        // 搜索框占满剩余宽度
        search-box := SearchBox {
            horizontal-stretch: 1;
            text <=> root.query;
            edited(q) => { root.query-edited(q); }
        }

        // 主题切换：图标显示"当前主题"（暗色 → 🌙，亮色 → ☀）
        SolidButton {
            text: Theme.is-dark ? "🌙" : "☀";
            clicked => { root.theme-clicked(); }
        }

        // 语言切换：显示"可切换到的语言"（英文界面显示"中文"，中文界面显示"EN"）
        SolidButton {
            text: Strings.lang-button;
            clicked => { root.lang-clicked(); }
        }

        IconButton {
            kind: IconKind.icon-import;
            clicked => { root.import-clicked(); }
        }
        IconButton {
            kind: IconKind.icon-export;
            clicked => { root.export-clicked(); }
        }
        IconButton {
            kind: IconKind.icon-add;
            clicked => { root.new-clicked(); }
        }
    }

    public function focus-search() {
        search-box.focus-input();
    }
}
